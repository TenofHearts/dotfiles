{
  "layer": "top",
  "position": "top",
  "height": 28,
  "spacing": 2,
  "modules-left": ["hyprland/window", "hyprland/workspaces#apps", "custom/workspace-layout", "hyprland/submap"],
  "modules-center": ["hyprland/workspaces"],
  "modules-right": ["pulseaudio", "network", "bluetooth", "battery", "clock"],

  "hyprland/submap": {
    "format": "{submap}",
    "default-submap": "Normal",
    "tooltip": false
  },
  "hyprland/window": {
    "format": "{class}",
    "rewrite": {
      "(?:com|dev|io|net|org)(?:\\.[^.]+)+\\.([^.]+)": "$1",
      "CosmicFiles": "COSMIC Files",
      "firefox": "Firefox",
      "ghostty": "Ghostty",
      "TextEditor": "Text Editor",
      "zen": "Zen Browser"
    },
    "max-length": 28,
    "separate-outputs": true,
    "tooltip": false
  },
  "hyprland/workspaces#apps": {
    "format": "{windows}",
    "format-window-separator": "",
    "active-only": true,
    "all-outputs": false,
    "max-windows": 6,
    "workspace-taskbar": {
      "enable": true,
      "icon-size": 16,
      "update-active-window": true,
      "on-click-window": "if [ {button} = 1 ]; then hyprctl eval 'hl.dispatch(hl.dsp.focus({window = \"address:{address}\"}))'; fi"
    }
  },
  "custom/workspace-layout": {
    "exec": "sh \"${XDG_CONFIG_HOME:-$HOME/.config}/waybar/workspace-layout.sh\"",
    "interval": 2,
    "hide-empty-text": true,
    "escape": true,
    "tooltip": false
  },
  "hyprland/workspaces": {
    "format": "{name}",
    "all-outputs": false,
    "sort-by": "number",
    "disable-scroll": true,
    "show-special": false
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "{icon} Muted",
    "format-icons": ["󰕿", "󰖀", "󰕾"],
    "tooltip-format": "{desc}: {volume}%"
  },
  "network": {
    "format-wifi": "{icon}",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰖪",
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "tooltip-format-wifi": "{essid} ({signalStrength}%)",
    "tooltip-format-ethernet": "{ifname}",
    "tooltip-format-disconnected": "Disconnected"
  },
  "bluetooth": {
    "format": "󰂯",
    "format-connected": "󰂱 {num_connections}",
    "format-disabled": "󰂲",
    "tooltip-format": "No devices connected",
    "tooltip-format-connected": "{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}"
  },
  "battery": {
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "states": {
      "warning": 30,
      "critical": 15
    }
  },
  "clock": {
    "format": "{:%a, %b %e · %H:%M}",
    "tooltip-format": "{:%A, %B %e, %Y}"
  }
}
